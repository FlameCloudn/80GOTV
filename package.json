{
  "name": "80gotv",
  "version": "1.0.0",
  "private": true,
  "description": "一个 CS2 赛事信息管理网站，包含前台展示、后台管理、数据直播和 Demo 导入。",
  "scripts": {
    "build": "vite build --config frontend/vite.config.mjs",
    "build:watch": "vite build --config frontend/vite.config.mjs --watch",
