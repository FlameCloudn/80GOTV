# 80GOTV 环境变量配置
# 复制此文件为 .env 并修改各配置项

# 本机启动固定关闭调试，并且只允许本机访问
FLASK_DEBUG=false
FLASK_RUN_HOST=127.0.0.1

# Flask 密钥（生产环境务必修改）
SECRET_KEY=change-me-to-a-random-secret

# 网站对外地址（Steam 验证完成后返回这里）
# 本机或 Cloudflare 临时隧道使用 auto；固定公网域名可填写 https://cs.example.com
PUBLIC_BASE_URL=auto

# 公网服务器可把数据库放到独立资料目录；本地留空即可
DATABASE_PATH=

# 使用 HTTPS 对外访问时改为 true；只在本机 http://127.0.0.1 调试时保持 false
SESSION_COOKIE_SECURE=false
# 固定公网域名可填写 .80gotv.cn，让 www 和主域名共享登录状态
SESSION_COOKIE_DOMAIN=
# 不要改回 Flask 默认的 session，否则可能与浏览器旧登录记录冲突
SESSION_COOKIE_NAME=80gotv_session

# 使用 Cloudflare Tunnel 等反向代理时改为 true
TRUST_PROXY=false

# 公网部署时填写允许访问网站的域名，多个用英文逗号分隔；本机调试可留空
TRUSTED_HOSTS=

# 管理员默认账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# GOTV Relay 通信密钥
GOTV_SECRET=change-me

# GSI Token（与 gamestate_integration_80gotv.cfg 中的 token 保持一致）
GSI_TOKEN=change-me

# Steam Web API（用于按公开的 CS2 游戏时长平衡个人报名队伍）
# 在 https://steamcommunity.com/dev/apikey 申请；不要提交真实密钥
STEAM_WEB_API_KEY=

# Turso 云数据库（留空则使用本地 SQLite）
TURSO_URL=
TURSO_TOKEN=

# csda 可执行文件路径（留空则自动搜索 PATH）
CSDA_PATH=
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=verify@mail.example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_NAME=80GOTV
