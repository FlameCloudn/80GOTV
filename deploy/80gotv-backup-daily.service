[Unit]
Description=80GOTV daily data backup

[Service]
Type=oneshot
User=80gotv
Group=80gotv
WorkingDirectory=/srv/80gotv/app
EnvironmentFile=/srv/80gotv/data/.env
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/flock --nonblock /srv/80gotv/backups/.backup.lock /srv/80gotv/venv/bin/python scripts/backup_site.py --output-dir /srv/80gotv/backups --keep 14
