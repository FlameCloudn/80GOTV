[Unit]
Description=80GOTV 数据直播后台程序
After=network-online.target 80gotv-web.service
Wants=network-online.target

[Service]
Type=simple
User=80gotv
Group=80gotv
WorkingDirectory=/srv/80gotv/app
EnvironmentFile=/srv/80gotv/data/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/80gotv/venv/bin/python live_worker.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
