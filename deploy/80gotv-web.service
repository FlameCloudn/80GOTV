[Unit]
Description=80GOTV 网站
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=80gotv
Group=80gotv
WorkingDirectory=/srv/80gotv/app
EnvironmentFile=/srv/80gotv/data/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/80gotv/venv/bin/gunicorn --workers 1 --threads 4 --timeout 600 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
