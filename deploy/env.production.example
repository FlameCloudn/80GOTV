# 复制为 /srv/80gotv/data/.env 后填写。不要上传到 GitHub。
# 下列占位内容不全部改完时，生产服务会拒绝启动。
FLASK_ENV=production
SECRET_KEY=请换成一段很长的随机字符
PUBLIC_BASE_URL=https://你的域名
DATABASE_PATH=/srv/80gotv/app/cs_site.db
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_NAME=80gotv_session
TRUST_PROXY=true
TRUSTED_HOSTS=你的域名

ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置管理员密码
GOTV_SECRET=请设置直播中继密钥
GSI_TOKEN=请设置观战数据密钥

TURSO_URL=
TURSO_TOKEN=
CSDA_PATH=/usr/local/bin/csda
BACKUP_DIR=/srv/80gotv/backups
